index 000000000..b9be9c854
--- /dev/null
+++ b/crates/zeroclaw-observability/src/lib.rs
@@ -0,0 +1,17 @@
+#![allow(
+    clippy::to_string_in_format_args,
+    clippy::useless_format,
+    clippy::manual_inspect
+)]
+//! Observer backends for ZeroClaw: log, verbose, Prometheus and OpenTelemetry export.
+//!
+//! Extracted from `zeroclaw-runtime`. Each module keeps its original name here, and
+//! `zeroclaw-runtime` re-exports it, so existing `zeroclaw_runtime::<module>` paths are unchanged.
+
+pub mod observability;
+
+// The moved files keep their original `crate::<module>` paths; these aliases point
+// them at the crate that owns that module now.
+// Each alias carries the same feature gate as the files that use it.
+#[cfg(feature = "observability-otel")]
+pub(crate) use zeroclaw_infra::util;
