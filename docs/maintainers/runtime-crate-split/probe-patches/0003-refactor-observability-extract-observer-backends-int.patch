@@ -0,0 +1,42 @@
+[package]
+name = "zeroclaw-observability"
+version.workspace = true
+edition.workspace = true
+license.workspace = true
+description = "Observer backends for ZeroClaw: log, verbose, Prometheus and OpenTelemetry export."
+repository.workspace = true
+homepage.workspace = true
+publish = true
+
+[dependencies]
+zeroclaw-api.workspace = true
+zeroclaw-config.workspace = true
+zeroclaw-log.workspace = true
+zeroclaw-providers.workspace = true
+anyhow = "1.0"
+async-trait = "0.1"
+chrono = { version = "0.4", default-features = false, features = ["clock", "std", "serde"] }
+parking_lot = "0.12"
+regex = "1.10"
+serde_json = { version = "1.0", default-features = false, features = ["std"] }
+tokio = { version = "1.50", default-features = false, features = ["rt-multi-thread", "macros", "time", "net", "io-util", "sync", "process", "io-std", "fs", "signal"] }
+prometheus = { version = "0.14", default-features = false, optional = true }
+opentelemetry = { version = "0.33", default-features = false, features = ["trace", "metrics", "logs"], optional = true }
+opentelemetry_sdk = { version = "0.33", default-features = false, features = ["trace", "metrics", "logs"], optional = true }
+opentelemetry-otlp = { version = "0.33", default-features = false, features = ["trace", "metrics", "logs", "http-proto", "reqwest-blocking-client", "reqwest-rustls"], optional = true }
+zeroclaw-infra.workspace = true
+
+[features]
+# Test-only helpers for OTHER crates' test builds; no production edge enables it.
+test-util = []
+observability-otel = ["dep:opentelemetry", "dep:opentelemetry_sdk", "dep:opentelemetry-otlp"]
+observability-prometheus = ["dep:prometheus"]
+
+[dev-dependencies]
+zeroclaw-spawn.workspace = true
+toml = "1.0"
+opentelemetry-proto = { version = "0.33", default-features = false, features = ["gen-tonic-messages", "logs"] }
+prost = { version = "0.14", default-features = false, features = ["derive"] }
+axum = { version = "0.8", default-features = false, features = ["http1", "json", "tokio"] }
+tokio = { version = "1.50", features = ["rt-multi-thread", "macros", "test-util"] }
+zeroclaw-config = { workspace = true, features = ["test-helpers"] }
diff --git a/crates/zeroclaw-observability/src/lib.rs b/crates/zeroclaw-observability/src/lib.rs
